{
    "name": "@navikt/nav-dekoratoren-moduler",
    "version": "4.5.3",
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
    "description": "Moduler til nav-dekoratoren",
    "author": "NAVIKT",
    "license": "MIT",
    "repository": "navikt/nav-dekoratoren-moduler",
    "main": "csr/index.js",
    "module": "csr/index.js",
    "source": "src/csr/index.tsx",
    "engines": {
        "node": "24.x || 26.x"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26",
            "onFail": "download"
        }
    },
    "scripts": {
        "start": "pnpm run --parallel --filter . \"/^start:.*/\"",
        "start:csr": "rollup -c rollup.config.csr.mjs -w",
        "start:ssr": "rollup -c rollup.config.ssr.mjs -w",
        "build": "pnpm run --parallel --filter . \"/^build:.*/\"",
        "build:csr": "rollup -c rollup.config.csr.mjs",
        "build:ssr": "rollup -c rollup.config.ssr.mjs",
        "prelint": "pnpm run build",
        "lint": "pnpm run lint:moduler && pnpm run lint:example-csr && pnpm run lint:example-next",
        "lint:moduler": "eslint src/ && tsc --noEmit",
        "lint:example-csr": "pnpm -C examples/csr run lint",
        "lint:example-next": "pnpm -C examples/next-app-router run lint",
        "test": "vitest run",
        "prepare": "husky",
        "predeploy": "cd example && pnpm install && pnpm run build",
        "publish:beta": "pnpm run build && npm version prerelease --preid beta && npm publish --access public --tag beta"
    },
    "files": [
        "csr",
        "ssr"
    ],
    "browser": {
        "child_process": false
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "peerDependencies": {
        "html-react-parser": ">=5.x",
        "react": ">=17.x"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "dependencies": {
        "@navikt/analytics-types": "0.0.9",
        "csp-header": "6.4.0",
        "js-cookie": "3.0.8"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/js-cookie": "3.0.6",
        "@types/jsdom": "21.1.7",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitest/eslint-plugin": "1.6.27",
        "eslint": "catalog:",
        "eslint-plugin-react": "catalog:",
        "globals": "catalog:",
        "html-react-parser": "catalog:",
        "husky": "9.1.7",
        "jsdom": "26.1.0",
        "prettier": "3.9.10",
        "rollup": "4.64.10",
        "rollup-plugin-dts": "6.5.1",
        "tslib": "2.8.1",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "5.0.5",
        "vitest-fetch-mock": "0.4.5"
    }
}
